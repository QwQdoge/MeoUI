pkgname=meoui-qml
pkgver=1.0.2
pkgrel=1
pkgdesc="Material Design 3 QML component library"
arch=('x86_64' 'aarch64')
url="https://github.com/QwQdoge/MeoUI"
license=('MIT')
depends=('qt6-declarative')
makedepends=('cmake' 'ninja' 'qt6-tools')
source=()
sha256sums=()

build() {
    local workspace="${startdir}/../.."
    cmake -B build -S "${workspace}" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DMEOUI_BUILD_SHOWCASE=OFF

    cmake --build build
}

package() {
    local workspace="${startdir}/../.."
    test -f "${workspace}/CMakeLists.txt"
    DESTDIR="$pkgdir" cmake --install build
}
