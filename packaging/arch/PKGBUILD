pkgname=meoui-qml
pkgver=1.0.4beta1
pkgrel=2
pkgdesc="MeoUI Qt Quick Material Design 3 component library"
arch=('x86_64' 'aarch64')
url="https://github.com/QwQdoge/MeoUI"
license=('MIT' 'Apache-2.0' 'OFL-1.1')
depends=('qt6-declarative' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'qt6-tools' 'qt6-shadertools')
source=()
sha256sums=()

build() {
    local workspace="${startdir}/../.."
    cmake -B build -S "${workspace}" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DMEOUI_BUILD_SHOWCASE=OFF

    cmake --build build
}

package() {
    local workspace="${startdir}/../.."
    test -f "${workspace}/CMakeLists.txt"
    DESTDIR="$pkgdir" cmake --install build
}
